            "arn": "arn:aws:states:us-east-1:024910003979:stateMachine:mlops-train-automation-pipeline",
            "creation_date": "2025-10-22T23:09:55Z",
            "definition": "{\"Comment\":\"ML Training Pipeline\",\"StartAt\":\"ValidateData\",\"States\":{\"CheckValidation\":{\"Choices\":[{\"Next\":\"LogMetrics\",\"StringEquals\":\"passed\",\"Variable\":\"$.validation_status\"}],\"Default\":\"ValidationFailed\",\"Type\":\"Choice\"},\"LogMetrics\":{\"Next\":\"TrainingSuccess\",\"Resource\":\"arn:aws:lambda:us-east-1:024910003979:function:mlops-train-automation-log-metrics\",\"Retry\":[{\"BackoffRate\":2,\"ErrorEquals\":[\"States.TaskFailed\"],\"IntervalSeconds\":2,\"MaxAttempts\":2}],\"Type\":\"Task\"},\"TrainingSuccess\":{\"Type\":\"Succeed\"},\"ValidateData\":{\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"ValidationFailed\"}],\"Next\":\"CheckValidation\",\"Resource\":\"arn:aws:lambda:us-east-1:024910003979:function:mlops-train-automation-validate\",\"Retry\":[{\"BackoffRate\":2,\"ErrorEquals\":[\"States.TaskFailed\"],\"IntervalSeconds\":2,\"MaxAttempts\":2}],\"Type\":\"Task\"},\"ValidationFailed\":{\"Cause\":\"Data validation failed\",\"Error\":\"ValidationError\",\"Type\":\"Fail\"}}}",
